{
  "name": "matttrifilo-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "e2e": "playwright test",
    "knowledge:check": "bun run scripts/knowledge-check.ts",
    "new-post": "bun run scripts/new-blog-post.ts",
    "evals": "bun run evals/run-and-report.ts full",
    "evals:run": "mkdir -p evals/out && PROMPTFOO_CACHE_ENABLED=false PROMPTFOO_SCHEDULER_QUEUE_TIMEOUT_MS=900000 PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --max-concurrency 8 --output evals/out/results.json",
    "evals:report": "bun run evals/summarize.ts evals/out/results.json evals/out/summary.json",
    "evals:publish": "bun run evals/publish.ts",
    "evals:smoke": "bun run evals/run-and-report.ts smoke",
    "evals:smoke:run": "mkdir -p evals/out && PROMPTFOO_CACHE_ENABLED=false PROMPTFOO_SCHEDULER_QUEUE_TIMEOUT_MS=900000 PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/promptfooconfig.yaml --max-concurrency 8 --filter-metadata smoke=true --output evals/out/smoke-results.json",
    "evals:compare": "PROMPTFOO_SCHEDULER_QUEUE_TIMEOUT_MS=900000 bun run evals/compare-reasoning.ts"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "^5.0.95",
    "@ai-sdk/react": "^4.0.121",
    "@mdx-js/mdx": "^3.1.1",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@vercel/analytics": "^1.6.1",
    "@vercel/oidc": "^3.8.9",
    "ai": "^7.0.118",
    "botid": "1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "google-auth-library": "^10.6.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "lucide-react": "^0.564.0",
    "next": "16.3.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.6",
    "happy-dom": "20.14.5",
    "promptfoo": "0.123.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
